generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id        Int      @id @default(autoincrement())
  tmdbId    Int
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  poster    String?
  year      Int?
  genre     String?
  rating    Float?
  runtime   Int?
  director  String?
  overview  String?
  status    String   @default("watched") // watched | watching | watchlist
  notes     String?
  progress  Int?
  watchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId])
}

model Series {
  id         Int      @id @default(autoincrement())
  tmdbId     Int
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title      String
  poster     String?
  year       Int?
  genre      String?
  rating     Float?
  overview   String?
  status     String   @default("watching") // watching | completed | watchlist
  notes      String?
  seriesMeta Json?
  updatedAt  DateTime @updatedAt

  @@unique([userId, tmdbId])
  @@index([userId])
}

model WatchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  mediaType String // movie | series
  tmdbId    Int
  title     String
  poster    String?
  action    String // watched | rated | added | started
  rating    Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String?
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  movies       Movie[]
  series       Series[]
  history      WatchHistory[]
}
